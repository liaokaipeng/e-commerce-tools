{
  "manifest_version": 3,
  "name": "Shopee 竞价导出助手",
  "version": "1.0.0",
  "description": "读取 Shopee 卖家中心登录 Cookie 并发送到本地导出工具（仅本机 127.0.0.1），用于批量导出竞价数据",
  "permissions": ["cookies"],
  "host_permissions": [
    "https://seller.shopee.cn/*",
    "https://*.shopee.cn/*",
    "https://*.shopee.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Shopee 竞价导出助手"
  }
}
