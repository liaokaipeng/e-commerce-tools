/bin/

# 打包产物（build/*.zip）与更新前的数据备份（backup/data-<时间戳>）
/build/
/backup/

# 研究用临时工具（Playwright 抓包等，含登录态与抓包数据，整体不入库）
research/

# HAR 抓包文件（含登录 Cookie，不入库）；整个目录忽略，防止混入截图/文本抓包
*.har
/har/

